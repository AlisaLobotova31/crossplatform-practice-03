{
  "name": "crossplatform-practice-03",
  "version": "1.0.0",
  "description": "Учебный файловый проводник на Electron (практическая работа № 3)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Лоботова Алиса Владимировна, ТРПО23-1",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ru.fa.student.fileexplorer",
    "productName": "Electron File Explorer",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
